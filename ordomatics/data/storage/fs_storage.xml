<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="fs_storage_s3_filestore" model="fs.storage">
        <field name="name">S3 Filestore</field>
        <field name="code">s3_filestore</field>
        <field name="protocol">s3</field>
        <field name="eval_options_from_env" eval="True"/>
        <field name="options">{
    "key": "$AWS_ACCESS_KEY_ID",
    "secret": "$AWS_SECRET_ACCESS_KEY",
    "client_kwargs": {
        "endpoint_url": "$AWS_ENDPOINT_URL",
        "region_name": "$AWS_REGION"
    }
}</field>
        <field name="directory_path">ordomatics-test-filestore</field>
        <!-- use_as_default_for_attachments and force_db_for_default_attachment_rules
             are server_env_mixin computed fields; they cannot be set via XML.
             The post_init_hook sets use_as_default_for_attachments=True and
             optionally overrides force_db_for_default_attachment_rules via
             FS_FORCE_DB_RULES env var. -->
    </record>
</odoo>
